# --- LLM provider (at least one required) ---
# Preferred provider if both are set. Defaults to groq, then openai.
LLM_PROVIDER=groq

# Groq (free tier, OpenAI-compatible): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Data sources (optional but recommended) ---

# GitHub personal access token (no scopes needed for public search):
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Reddit "script" app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Cost controls ---
MAX_CANDIDATES_TO_CLASSIFY=20
